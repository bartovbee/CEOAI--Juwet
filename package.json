{
  "name": "ceoai-juwet",
  "version": "0.1.0",
  "description": "CEOAI Juwet integrated HTTP proxy, cache and dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node tests/smoke.js && node tests/integration.js",
    "build:windows": "pkg server.js --config package.json --targets node18-win-x64 --output dist/CEOAI-Juwet.exe"
  },
  "dependencies": {},
