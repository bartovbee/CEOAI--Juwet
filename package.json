{
  "name": "ceoai-juwet",
  "version": "0.1.0",
  "description": "CEOAI Juwet integrated HTTP proxy, cache and dashboard",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "test": "node tests/smoke.js && node tests/integration.js",
    "build:windows": "electron-builder --win portable --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "pkg": {
    "assets": [
      "public/*",
      "public/**/*"
    ],
    "scripts": [
      "server.js"
    ]
  },
  "build": {
    "appId": "net.bartovbee.ceoaijuwet",
    "productName": "CEOAI Juwet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "server.js",
      "public/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CEOAI-Juwet.exe"
    },
    "portable": {
      "artifactName": "CEOAI-Juwet.exe"
    }
  }
}
