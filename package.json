{
  "name": "ceoai-juwet",
  "version": "0.1.0",
  "description": "CEOAI Juwet integrated HTTP proxy, optional TLS inspection, HTTPS-aware cache and dashboard",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "test": "node tests/smoke.js && node tests/integration.js",
    "build:windows": "electron-builder --win portable --x64",
    "prebuild:windows": "node scripts/make-icon.js"
  },
  "dependencies": {
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.3",
    "png-to-ico": "^2.1.8"
  },
  "pkg": {
    "assets": [
      "public/*",
      "public/**/*"
    ],
    "scripts": [
      "server.js"
    ]
  },
  "build": {
    "appId": "net.bartovbee.ceoaijuwet",
    "productName": "CEOAI Juwet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "server.js",
      "public/**/*",
      "package.json",
      "build/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CEOAI-Juwet.exe",
      "icon": "build/ceoai-juwet.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "CEOAI-Juwet.exe"
    }
  }
}
